{
  "info": {
    "name": "NexusAPI",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "test_mail", "value": "appnexus26@gmail.com" }
  ],
  "item": [
    {
      "name": "1. Kayit Akisi",
      "item": [
        {
          "name": "1a. Kayit Ol (OTP gönderir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isim\": \"Test\",\n  \"soyisim\": \"Kullanici\",\n  \"mail\": \"{{test_mail}}\",\n  \"cinsiyet\": \"erkek\",\n  \"sifre\": \"Test123!\"\n}"
            }
          }
        },
        {
          "name": "1b. OTP Dogrula (hesap aktif + token döner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('token', data.access_token);",
                  "  console.log('Token kaydedildi.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/verify-otp", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\",\n  \"otp\": \"123456\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Sifre Sifirla",
      "item": [
        {
          "name": "3a. OTP Gonder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/sifre-sifirla/istek", "host": ["{{base_url}}"], "path": ["api", "auth", "sifre-sifirla", "istek"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\"\n}"
            }
          }
        },
        {
          "name": "3b. OTP Dogrula + Yeni Sifre",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/sifre-sifirla/dogrula", "host": ["{{base_url}}"], "path": ["api", "auth", "sifre-sifirla", "dogrula"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\",\n  \"otp\": \"123456\",\n  \"yeni_sifre\": \"YeniSifre123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Giris Akisi",
      "item": [
        {
          "name": "2a. Giris Yap (direkt token döner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('token', data.access_token);",
                  "  console.log('Token kaydedildi.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\",\n  \"sifre\": \"Test123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Profil",
      "item": [
        {
          "name": "Profil Getir",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Profil Guncelle",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/auth/me", "host": ["{{base_url}}"], "path": ["api", "auth", "me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isim\": \"Yeni Isim\",\n  \"soyisim\": \"Yeni Soyisim\",\n  \"cinsiyet\": \"erkek\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Lunch",
      "item": [
        {
          "name": "Session Durumu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/session/durum", "host": ["{{base_url}}"], "path": ["api", "lunch", "session", "durum"] }
          }
        },
        {
          "name": "AI Mekan Listesi",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/lunch/mekanlar?lat=39.9564292&lng=32.8526627",
              "host": ["{{base_url}}"],
              "path": ["api", "lunch", "mekanlar"],
              "query": [
                { "key": "lat", "value": "39.9564292" },
                { "key": "lng", "value": "32.8526627" }
              ]
            }
          }
        },
        {
          "name": "Mekan Oner",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/lunch/oner", "host": ["{{base_url}}"], "path": ["api", "lunch", "oner"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isim\": \"Haci Arif Bey\",\n  \"adres\": \"Kizilay, Ankara\",\n  \"mutfak_turu\": \"Turk\"\n}"
            }
          }
        },
        {
          "name": "Onerileri Listele",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/oneriler", "host": ["{{base_url}}"], "path": ["api", "lunch", "oneriler"] }
          }
        },
        {
          "name": "Oy Ver / Geri Al",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/oy/1", "host": ["{{base_url}}"], "path": ["api", "lunch", "oy", "1"] }
          }
        },
        {
          "name": "Sonuclar / Leaderboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/sonuclar", "host": ["{{base_url}}"], "path": ["api", "lunch", "sonuclar"] }
          }
        },
        {
          "name": "Gecmis Sessionlar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/gecmis", "host": ["{{base_url}}"], "path": ["api", "lunch", "gecmis"] }
          }
        }
      ]
    },
    {
      "name": "5. Hata Senaryolari",
      "item": [
        {
          "name": "Verify edilmemis hesapla giris (401 beklenir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"dogrulanmamis@nexus.com\",\n  \"sifre\": \"Test123!\"\n}"
            }
          }
        },
        {
          "name": "Yanlis sifre (401 beklenir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\",\n  \"sifre\": \"yanlis_sifre\"\n}"
            }
          }
        },
        {
          "name": "Gecersiz OTP (401 beklenir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/verify-otp", "host": ["{{base_url}}"], "path": ["api", "auth", "verify-otp"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mail\": \"{{test_mail}}\",\n  \"otp\": \"000000\"\n}"
            }
          }
        },
        {
          "name": "Mukerrer kayit (400 beklenir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isim\": \"Test\",\n  \"soyisim\": \"Kullanici\",\n  \"mail\": \"{{test_mail}}\",\n  \"cinsiyet\": \"erkek\",\n  \"sifre\": \"Test123!\"\n}"
            }
          }
        },
        {
          "name": "Token olmadan istek (403 beklenir)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/lunch/oneriler", "host": ["{{base_url}}"], "path": ["api", "lunch", "oneriler"] }
          }
        },
        {
          "name": "Olmayan mekan oyu (404 beklenir)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/lunch/oy/9999", "host": ["{{base_url}}"], "path": ["api", "lunch", "oy", "9999"] }
          }
        },
        {
          "name": "Mukerrer mekan onerisi (400 beklenir)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/lunch/oner", "host": ["{{base_url}}"], "path": ["api", "lunch", "oner"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isim\": \"Haci Arif Bey\",\n  \"adres\": \"Kizilay, Ankara\",\n  \"mutfak_turu\": \"Turk\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    }
  ]
}
